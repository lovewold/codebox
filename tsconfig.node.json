{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "declaration": false,
    "esModuleInterop": true
  },
  "include": ["electron/**/*.ts", "vite.config.ts"]
}
